    "settings.language.relaunch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing language applies the next time Folio opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma se aplica la próxima vez que abras Folio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le changement de langue s’applique au prochain lancement de Folio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache gilt beim nächsten Start von Folio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua viene applicata al prossimo avvio di Folio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma vale na próxima vez que o Folio abrir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma aplica-se da próxima vez que o Folio abrir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De taalwijziging geldt de volgende keer dat Folio opent."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprogændringen gælder næste gang, Folio åbnes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Språkbytet gäller nästa gång Folio öppnas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Språkendringen gjelder neste gang Folio åpnes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kielimuutos tulee voimaan, kun Folio avataan seuraavan kerran."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana języka zadziała przy następnym otwarciu Folio."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna jazyka se použije při příštím otevření Folia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyelvváltozás a Folio következő megnyitásakor érvényesül."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbarea limbii se aplică la următoarea deschidere a Folio."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αλλαγή γλώσσας εφαρμόζεται την επόμενη φορά που θα ανοίξει το Folio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil değişikliği Folio bir sonraki açılışında uygulanır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смена языка применится при следующем открытии Folio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна мови застосується під час наступного відкриття Folio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطبَّق تغيير اللغة في المرة التالية التي تفتح فيها Folio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינוי השפה יחול בפעם הבאה שFolio ייפתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषा बदलना अगली बार Folio खुलने पर लागू होगा।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนภาษาจะมีผลเมื่อเปิด Folio ครั้งถัดไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi ngôn ngữ có hiệu lực lần sau khi mở Folio."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan bahasa berlaku saat Folio dibuka berikutnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語の変更は、次にFolioを開いたときに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 변경은 Folio를 다음에 열 때 적용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改语言将在下次打开 Folio 时生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更語言會在下次開啟 Folio 時套用。"
          }
        }
      }
    },
