    "merge.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange pages in the tray, then export one file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena las páginas en la bandeja y exporta un solo archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Classez les pages dans le plateau, puis exportez un seul fichier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiten im Fach anordnen und als eine Datei exportieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponi le pagine nel vassoio e poi esporta un solo file."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize as páginas na bandeja e exporte um único arquivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize as páginas no tabuleiro e exporte um único ficheiro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rangschik pagina’s in het blad en exporteer één bestand."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrangér siderne i bakken, og eksportér én fil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordna sidorna i facket och exportera en fil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordne sidene i brettet og eksporter én fil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestä sivut tarjottimelle ja vie yhtenä tiedostona."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ułóż strony na tacy i wyeksportuj jeden plik."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uspořádejte stránky na tácu a exportujte jeden soubor."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendezze az oldalakat a tálcán, majd exportáljon egy fájlt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordonează paginile în tavă, apoi exportă un singur fișier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τακτοποιήστε τις σελίδες στο δίσκο και εξάγετε ένα αρχείο."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfaları tepside düzenleyip tek dosya olarak dışa aktarın."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разложите страницы в лотке и экспортируйте один файл."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Упорядкуйте сторінки в лотку й експортуйте один файл."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رتّب الصفحات في الصينية ثم صدّر ملفًا واحدًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סדרו עמודים במגש ואז ייצאו קובץ אחד."
