    "empty.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files stay on this Mac. Export never overwrites the original unless you ask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos se quedan en este Mac. Exportar no sustituye el original salvo que lo pidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers restent sur ce Mac. L’export n’écrase l’original que si vous le demandez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien bleiben auf diesem Mac. Export überschreibt das Original nur auf Wunsch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file restano su questo Mac. Esporta non sovrascrive l’originale se non lo chiedi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos ficam neste Mac. Exportar não substitui o original sem você pedir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros ficam neste Mac. Exportar não substitui o original sem pedido."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden blijven op deze Mac. Exporteren overschrijft het origineel alleen als je dat vraagt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filerne bliver på denne Mac. Eksport overskriver ikke originalen, medmindre du beder om det."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filerna stannar på den här Macen. Export skriver inte över originalet om du inte ber om det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filene blir på denne Macen. Eksport overskriver ikke originalen med mindre du ber om det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostot pysyvät tällä Macilla. Vienti ei korvaa alkuperäistä, ellet pyydä sitä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki zostają na tym Macu. Eksport nie nadpisze oryginału, chyba że o to poprosisz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory zůstanou na tomto Macu. Export nepřepíše originál, pokud o to nepožádáte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlok ezen a Macen maradnak. Az export csak kérésre írja felül az eredetit."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierele rămân pe acest Mac. Exportul nu înlocuiește originalul decât dacă ceri."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αρχεία μένουν σε αυτό το Mac. Η εξαγωγή δεν αντικαθιστά το πρωτότυπο εκτός αν το ζητήσετε."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar bu Mac’te kalır. Dışa aktarma, siz istemedikçe özgün dosyanın üzerine yazmaz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы остаются на этом Mac. Экспорт не заменяет оригинал, пока вы не попросите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли залишаються на цьому Mac. Експорт не замінює оригінал, доки ви не попросите."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الملفات على هذا الـ Mac. التصدير لا يستبدل الأصل إلا إذا طلبت ذلك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקבצים נשארים ב‑Mac הזה. ייצוא לא דורס את המקור אלא אם תבקשו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें इस Mac पर रहती हैं। जब तक आप न कहें, निर्यात मूल को नहीं लिखेगा।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์อยู่บน Mac เครื่องนี้ การส่งออกจะไม่แทนที่ต้นฉบับจนกว่าคุณจะขอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp ở lại trên Mac này. Xuất không ghi đè bản gốc trừ khi bạn yêu cầu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File tetap di Mac ini. Ekspor tidak menimpa asli kecuali Anda memintanya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはこのMacに残ります。書き出しは、指示しない限り原本を上書きしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 이 Mac에 남습니다. 요청하지 않으면보내기는 원본을 덮어쓰지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件只会留在这台 Mac 上。除非你要求，导出不会覆盖原件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案只會留在這部 Mac。除非你要求，匯出不會覆蓋原本檔案。"
          }
        }
      }
    },
