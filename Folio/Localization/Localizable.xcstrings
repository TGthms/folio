    "ocr.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognize text on scanned pages and write a searchable PDF. On this Mac only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconoce el texto de páginas escaneadas y crea un PDF buscable. Solo en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnaître le texte des pages scannées et créer un PDF consultable. Sur ce Mac uniquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text auf gescannten Seiten erkennen und ein durchsuchbares PDF schreiben. Nur auf diesem Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconosci il testo delle pagine scansionate e scrivi un PDF ricercabile. Solo su questo Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconheça o texto de páginas digitalizadas e grave um PDF pesquisável. Só neste Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconheça o texto de páginas digitalizadas e grave um PDF pesquisável. Só neste Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herken tekst op gescande pagina’s en schrijf een doorzoekbare pdf. Alleen op deze Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genkend tekst på scannede sider, og skriv en søgbar PDF. Kun på denne Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Känn igen text på skannade sidor och skriv en sökbar PDF. Endast på den här Macen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenkjenn tekst på skannede sider og skriv en søkbar PDF. Bare på denne Macen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnista skannattujen sivujen teksti ja kirjoita haettava PDF. Vain tällä Macilla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznaj tekst na zeskanowanych stronach i zapisz przeszukiwalny PDF. Tylko na tym Macu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznejte text na naskenovaných stránkách a zapište prohledávatelný PDF. Pouze na tomto Macu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ismerje fel a szkennelt oldalak szövegét, és írjon kereshető PDF-et. Csak ezen a Macen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Recunoaște textul paginilor scanate și scrie un PDF căutabil. Doar pe acest Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναγνωρίστε κείμενο σε σαρωμένες σελίδες και γράψτε αναζητήσιμο PDF. Μόνο σε αυτό το Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taranmış sayfalardaki metni tanıyıp aranabilir bir PDF yazın. Yalnızca bu Mac’te."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознайте текст на отсканированных страницах и запишите searchable PDF. Только на этом Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розпізнайте текст на сканованих сторінках і запишіть PDF для пошуку. Лише на цьому Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرّف على نص الصفحات الممسوحة واكتب PDFًا قابلاً للبحث. على هذا الـ Mac فقط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זהו טקסט בעמודים סרוקים וכתבו PDF שניתן לחיפוש. במחשב Mac זה בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन किए पृष्ठों का पाठ पहचानें और खोजने योग्य PDF लिखें। केवल इस Mac पर।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รู้จำข้อความในหน้าสแกนแล้วเขียน PDF ที่ค้นหาได้ เฉพาะบน Mac เครื่องนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận dạng chữ trên trang quét và ghi PDF tìm kiếm được. Chỉ trên Mac này."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenali teks pada halaman pindaian dan tulis PDF yang dapat dicari. Hanya di Mac ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンしたページの文字を認識し、検索可能なPDFを作ります。このMac上のみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔한 페이지의 글자를 인식해 검색 가능한 PDF를 만듭니다. 이 Mac에서만 실행됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别扫描页上的文字并生成可搜索的 PDF。仅在此 Mac 上进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "辨識掃描頁上的文字並寫出可搜尋的 PDF。只在這部 Mac 上進行。"
          }
        }
      }
    },
    "unlock.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write an unlocked copy. Folio needs the password you used when opening the file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una copia desbloqueada. Folio necesita la contraseña con la que abriste el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrire une copie déverrouillée. Folio a besoin du mot de passe utilisé à l’ouverture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine entsperrte Kopie schreiben. Folio braucht das Passwort vom Öffnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi una copia sbloccata. Folio ha bisogno della password usata all’apertura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave uma cópia desbloqueada. O Folio precisa da senha usada ao abrir o arquivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave uma cópia desbloqueada. O Folio precisa da palavra-passe usada ao abrir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf een ontgrendelde kopie. Folio heeft het wachtwoord nodig waarmee je het bestand opende."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv en ulåst kopi. Folio skal bruge den adgangskode, du åbnede filen med."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv en olåst kopia. Folio behöver lösenordet du använde när du öppnade filen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv en ulåst kopi. Folio trenger passordet du brukte da du åpnet filen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita lukitsematon kopio. Folio tarvitsee salasanan, jolla avasit tiedoston."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz odblokowaną kopię. Folio potrzebuje hasła użytego przy otwieraniu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapište odemčenou kopii. Folio potřebuje heslo použité při otevření."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írjon zárolatlan másolatot. A Foliónak szüksége van a megnyitáskor használt jelszóra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrie o copie deblocată. Folio are nevoie de parola folosită la deschidere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γράψτε ένα ξεκλείδωτο αντίγραφο. Το Folio χρειάζεται τον κωδικό με τον οποίο ανοίξατε το αρχείο."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilidi açık bir kopya yazın. Folio, dosyayı açarken kullandığınız parolaya ihtiyaç duyar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите разблокированную копию. Folio нужен пароль, которым вы открыли файл."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть розблоковану копію. Folio потрібен пароль, яким ви відкрили файл."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب نسخة غير مقفلة. يحتاج Folio إلى كلمة المرور التي استخدمتها عند الفتح."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתבו עותק לא נעול. Folio צריך את הסיסמה שבה פתחתם את הקובץ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनलॉक प्रतिलिपि लिखें। Folio को वह पासवर्ड चाहिए जिससे आपने फ़ाइल खोली।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนสำเนาที่ปลดล็อก Folio ต้องการรหัสผ่านที่ใช้ตอนเปิดไฟล์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi bản sao đã mở khóa. Folio cần mật khẩu bạn đã dùng khi mở tệp."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis salinan tanpa kunci. Folio memerlukan kata sandi saat Anda membuka file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック解除したコピーを書き出します。開いたときに使ったパスワードが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 해제된 복사본을 씁니다. 파일을 열 때 사용한 암호가 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写出未锁定的副本。Folio 需要你打开文件时使用的密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫出未鎖定的副本。Folio 需要你開啟檔案時使用的密碼。"
          }
        }
      }
    },
