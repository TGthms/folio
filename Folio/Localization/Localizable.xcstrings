    "redact.warning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redacted pages become images so the hidden text cannot be recovered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas tachadas se convierten en imágenes para que el texto no se pueda recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages caviardées deviennent des images pour que le texte ne puisse pas être récupéré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschwärzte Seiten werden zu Bildern, damit der Text nicht wiederhergestellt werden kann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pagine oscurate diventano immagini così il testo non può essere recuperato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Páginas redigidas viram imagens para o texto não poder ser recuperado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As páginas redigidas tornam-se imagens para o texto não poder ser recuperado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geredigeerde pagina’s worden afbeeldingen, zodat de verborgen tekst niet te herstellen is."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigerede sider bliver billeder, så den skjulte tekst ikke kan gendannes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigerade sidor blir bilder så att den dolda texten inte kan återställas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigerte sider blir bilder slik at den skjulte teksten ikke kan gjenopprettes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Peitetyistä sivuista tulee kuvia, joten piilotettua tekstiä ei voi palauttaa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zredagowane strony stają się obrazami, więc ukrytego tekstu nie da się odzyskać."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigované stránky se stanou obrázky, takže skrytý text nelze obnovit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kitakart oldalak képpé válnak, így a rejtett szöveg nem állítható vissza."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Paginile redactate devin imagini, astfel încât textul ascuns nu poate fi recuperat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αποκρυμμένες σελίδες γίνονται εικόνες ώστε το κρυφό κείμενο να μην ανακτάται."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karartılan sayfalar görüntü olur; gizli metin geri alınamaz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отредактированные страницы становятся изображениями, поэтому скрытый текст нельзя восстановить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відредаговані сторінки стають зображеннями, тож прихований текст не відновити."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصبح الصفحات المنقّحة صورًا حتى يتعذر استرداد النص المخفي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עמודים שהושחרו הופכים לתמונות כדי שלא ניתן יהיה לשחזר את הטקסט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संपादित पृष्ठ छवियाँ बन जाते हैं ताकि छिपा पाठ वापस न मिले।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าที่ปิดทับจะกลายเป็นรูป จึงกู้ข้อความที่ซ่อนไม่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang đã che trở thành ảnh nên không khôi phục được chữ ẩn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman tersensor menjadi gambar sehingga teks tersembunyi tidak dapat dipulihkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "墨消ししたページは画像になるため、隠した文字は取り出せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "교정된 페이지는 이미지가 되어 숨긴 텍스트를 복구할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密文处理后的页面会变成图片，隐藏的文字无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遮罩後的頁面會變成影像，隱藏的文字無法復原。"
          }
        }
      }
    },
